# Copy to .env (gitignored) and fill in. Never commit real values.

# Telegram bot (create with @BotFather → /newbot)
TELEGRAM_BOT_TOKEN=
# Only this chat is served. Start the bot, send /start, it replies with your id.
TELEGRAM_ALLOWED_CHAT_ID=

# Claude (console.anthropic.com → API keys) — used only for free-text messages
ANTHROPIC_API_KEY=
# LIFELOG_MODEL=claude-haiku-5-5
# LIFELOG_EFFORT=low

# Local voice transcription (uv sync --extra voice): base | small | medium
# WHISPER_MODEL=small

# Reminder times (America/Sao_Paulo)
# LIFELOG_MORNING=08:00
# LIFELOG_AFTERNOON=15:00
# LIFELOG_WHO5=20:00      # Sundays
# LIFELOG_MONTHLY=21:00   # last day of the month (PSS-10 + life satisfaction)

# Where private events live (gitignored)
# LIFELOG_DATA_DIR=data/private

# Private online dashboard (Cloudflare Pages + Access) — see docs/private-dashboard.md
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=          # token with "Cloudflare Pages: Edit"
# LIFELOG_PAGES_PROJECT=lifelog-private
# Set to 1 ONLY after Access protects <project>.pages.dev AND *.<project>.pages.dev
# LIFELOG_ACCESS_CONFIRMED=0
